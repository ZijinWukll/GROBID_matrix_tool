{
  "schema_version": 1,
  "grobid_url": "http://localhost:8070",
  "output_path": "data/exports/matrix.xlsx",
  "paper_order": ["PAPER1"],
  "translation": {
    "engine": "mymemory",
    "endpoint": "https://api.mymemory.translated.net/get",
    "source_lang": "en",
    "target_lang": "zh-CN",
    "enabled": true,
    "timeout": 15,
    "delay": 0.2,
    "max_per_run": 500
  },
  "context_window": {
    "before": 2,
    "after": 2
  },
  "papers": {
    "PAPER1": {
      "pdf": "data/seed_papers/paper1.pdf",
      "tei": "data/state/papers/PAPER1.tei.xml",
      "header": "example paper header",
      "added": "YYYY-MM-DD"
    }
  }
}
